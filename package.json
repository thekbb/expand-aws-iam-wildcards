{
  "name": "expand-aws-iam-wildcards",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "description": "GitHub Action to expand IAM wildcard actions in PR comments",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:check": "tsx scripts/build.ts --check",
    "build:smoke": "tsx scripts/build.ts --smoke",
    "check": "npm run generate-iam-data && npm run lint && npm run lint:md && npm run docs:check && npm run typecheck && npm run test:coverage && npm run build:smoke",
    "docs:check": "tsx scripts/check-docs.ts",
    "lint": "eslint .",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "prepare": "npm run generate-iam-data",
    "release": "tsx scripts/release.ts",
    "release:check-files": "tsx scripts/check-release-files.ts",
    "release:report-iam-data": "tsx scripts/report-iam-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate-iam-data": "tsx scripts/generate-iam-data.ts"
  },
  "keywords": [
    "github-action",
    "aws",
    "iam",
    "security"
  ],
  "author": {
    "name": "Kevin Behrens",
    "email": "kevin@thekbb.net"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "~9.1.0",
    "minimatch": "^10.0.0"
  },
  "devDependencies": {
    "@cloud-copilot/iam-data": "0.21.202608251",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.1",
    "@vercel/ncc": "~0.45.0",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^10.0.0",
    "js-yaml": "^5.3.0",
    "markdownlint-cli": "~0.49.0",
    "tsx": "~4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "~4.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true
  }
}
